# ============================================================================
# Camera station settings (docker-compose.client.yml)
# Copy this file to .env on the machine with the webcam and change the values:
#   cp .env.station.example .env
# ============================================================================

# The scanner server's address. On the same machine as the server: http://server:5000
SCANNER_SERVER=http://192.168.1.20:5000

# The camera: its name from `ls /dev/v4l/by-id/` (the one ending in -video-index0).
# A number works too (2 = /dev/video2) but can change when the camera is plugged in again.
# Empty: camera.usb_index in config.yaml.
SCANNER_CAMERA_INDEX=/dev/v4l/by-id/usb-YOUR_CAMERA-video-index0

# What the server calls this camera
SCANNER_STATION_NAME=Desk camera

# Optional: this camera's id on the server and in its page's address (/scan/<id>).
# Default: the machine's name. Keep it once cards were scanned - they are filed under it.
# SCANNER_STATION_ID=desk

# Only if the server was given a token (SCANNER_STATION_TOKEN in its .env)
# SCANNER_STATION_TOKEN=
